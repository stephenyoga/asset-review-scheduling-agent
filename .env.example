# ============================================================
# 素材审核与发布排期 Agent —— 环境变量示例
# 默认使用离线 Mock 决策器，【无需配置任何变量】即可运行。
# 仅在需要真实 LLM 决策时，填写下方任一厂商的变量并指定 provider。
# ============================================================

# 决策器：mock（默认）| deepseek | qwen | claude
AGENT_LLM_PROVIDER=mock

# ---- DeepSeek（OpenAI 兼容）----
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 通义千问 Qwen（DashScope OpenAI 兼容）----
# QWEN_API_KEY=sk-xxx
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ---- Claude（Anthropic OpenAI 兼容端点）----
# CLAUDE_API_KEY=sk-ant-xxx
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# CLAUDE_MODEL=claude-sonnet-4-6
